[Unit]
Description=Astra Panel API (uvicorn)
After=network.target redis-server.service postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=astra
Group=astra
WorkingDirectory=/opt/astra/backend
Environment=ASTRA_BIND_HOST=127.0.0.1
Environment=ASTRA_APP_PORT=2086
EnvironmentFile=-/opt/astra/.env
# Pin AFTER EnvironmentFile so .env cannot stampede workers again
Environment=ASTRA_ROLE=api
Environment=ASTRA_WEB_CONCURRENCY=3
Environment=PATH=/opt/astra/backend/.venv/bin:/usr/local/bin:/usr/bin
ExecStart=/opt/astra/backend/.venv/bin/uvicorn app.main:app --host ${ASTRA_BIND_HOST} --port ${ASTRA_APP_PORT} --workers ${ASTRA_WEB_CONCURRENCY} --loop uvloop --http httptools --limit-concurrency 100 --timeout-keep-alive 8 --timeout-graceful-shutdown 15 --no-access-log --log-level warning
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=45
CPUQuota=350%
TasksMax=8192
OOMPolicy=continue
NoNewPrivileges=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
