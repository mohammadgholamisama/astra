usage() {
  cat <<EOF
Usage: astra-helper <command> [args]

Commands:
  reload-nginx
  write-nginx [path-to-conf]   # omit path → render from .env state
  issue-ssl <domain>
  set-env <KEY> <VALUE>        # allowed keys only
  set-admin <username> <password>
  restart-astra
  check-update                 # JSON status (preserves data)
  apply-update                 # pull latest; keeps .env + data/
  uninstall [--purge]          # remove Astra from server (other apps safe)
EOF
}

main() {
  local cmd="${1:-}"
  shift || true
  case "$cmd" in
    reload-nginx)  cmd_reload_nginx ;;
    write-nginx)   cmd_write_nginx "${1:-}" ;;
    issue-ssl)     cmd_issue_ssl "${1:-}" ;;
    set-env)       cmd_set_env "${1:-}" "${2:-}" ;;
    set-admin)     cmd_set_admin "${1:-}" "${2:-}" ;;
    restart-astra) cmd_restart_astra ;;
    check-update)  cmd_check_update ;;
    apply-update)  cmd_apply_update ;;
    uninstall)     cmd_uninstall "${1:-}" ;;
    ""|-h|--help)  usage ;;
    *)             die "unknown command: $cmd" ;;
  esac
}

main "$@"
