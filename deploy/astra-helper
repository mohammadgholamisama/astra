#!/usr/bin/env bash
# Astra root helper — called via sudo from x-astra / panel user.
# Allowed actions only; no arbitrary shell.
set -euo pipefail

ASTRA_ROOT="/opt/astra"
ENV_FILE="${ASTRA_ROOT}/.env"
NGINX_SITE="/etc/nginx/sites-available/astra"
NGINX_LINK="/etc/nginx/sites-enabled/astra"
HTTP_TPL="${ASTRA_ROOT}/deploy/nginx-http.conf.tpl"
SSL_TPL="${ASTRA_ROOT}/deploy/nginx-ssl.conf.tpl"
STATE_FILE="${ASTRA_ROOT}/deploy/install-state"

# Keys astra-helper may change in .env
ALLOWED_ENV_KEYS=(
  ASTRA_APP_PORT
  ASTRA_BIND_HOST
  ASTRA_NGINX_SHARE
  PANEL_BASE_URL
  SUB_BASE_URL
  PANEL_NAME
  CORS_ORIGINS
  ASTRA_PANEL_DOMAIN
  ASTRA_SUB_DOMAIN
  ASTRA_SSL_PANEL
  ASTRA_SSL_SUB
  ASTRA_HELPER
  ADMIN_USERNAME
  ADMIN_PASSWORD
)

die() { echo "astra-helper: $*" >&2; exit 1; }

need_root() {
  [[ "$(id -u)" -eq 0 ]] || die "must run as root (use sudo)"
}

valid_domain() {
  local d="$1"
  [[ "$d" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)+$ ]]
}

valid_port() {
  local p="$1"
  [[ "$p" =~ ^[0-9]+$ ]] && (( p >= 1 && p <= 65535 ))
}

get_env() {
  local key="$1" def="${2:-}"
  if [[ -f "$ENV_FILE" ]] && grep -qE "^${key}=" "$ENV_FILE"; then
    sed -n "s/^${key}=//p" "$ENV_FILE" | head -n1 | tr -d '\r'
  else
    echo "$def"
  fi
}

set_env_key() {
  local key="$1" val="$2"
  local allowed=0 k
  for k in "${ALLOWED_ENV_KEYS[@]}"; do
    [[ "$k" == "$key" ]] && allowed=1 && break
  done
  [[ "$allowed" -eq 1 ]] || die "key not allowed: $key"
  # reject newlines / shell metachar injection in values
  [[ "$val" != *$'\n'* && "$val" != *$'\r'* ]] || die "invalid value"
  touch "$ENV_FILE"
  if grep -qE "^${key}=" "$ENV_FILE"; then
    sed -i "s|^${key}=.*|${key}=${val}|" "$ENV_FILE"
  else
    echo "${key}=${val}" >> "$ENV_FILE"
  fi
}

read_port() {
  local p
  p="$(get_env ASTRA_APP_PORT 2086)"
  valid_port "$p" || p=2086
  echo "$p"
}

# Panel / IP host: admin SPA + API + docs + sub
panel_locations() {
  local port="$1"
  cat <<EOF
    location /api/ {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 120s;
    }

    location /sub {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location /docs {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location /redoc {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location = /openapi.json {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location / {
        try_files \$uri \$uri/ /index.html;
    }
EOF
}

# Subscription-only host: /sub links work; NO admin login SPA
sub_locations() {
  local port="$1"
  cat <<EOF
    location /sub {
        proxy_pass http://127.0.0.1:${port};
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto \$scheme;
        proxy_read_timeout 120s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:${port};
        proxy_set_header Host \$host;
        proxy_set_header X-Forwarded-Proto \$scheme;
    }

    location / {
        default_type text/html;
        charset utf-8;
        return 200 '<!DOCTYPE html><html lang="fa" dir="rtl"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>Subscription</title><style>body{margin:0;min-height:100vh;display:grid;place-items:center;font-family:system-ui,sans-serif;background:#07141e;color:#ecfaf6}main{text-align:center;padding:24px;opacity:.85}h1{font-size:1.1rem;font-weight:700;margin:0 0 8px}p{margin:0;font-size:.9rem;color:#7fa39a}</style></head><body><main><h1>دامنه اشتراک</h1><p>این آدرس فقط برای لینک ساب است، نه پنل مدیریت.</p></main></body></html>';
    }
EOF
}

locations_for_mode() {
  local port="$1" mode="${2:-panel}"
  if [[ "$mode" == "sub" ]]; then
    sub_locations "$port"
  else
    panel_locations "$port"
  fi
}

count_other_nginx_sites() {
  local n=0 f base
  shopt -s nullglob
  for f in /etc/nginx/sites-enabled/*; do
    base="$(basename "$f")"
    [[ "$base" == "astra" ]] && continue
    n=$((n + 1))
  done
  shopt -u nullglob
  echo "$n"
}

is_share_mode() {
  local flag
  flag="$(get_env ASTRA_NGINX_SHARE "")"
  if [[ "$flag" == "1" || "$flag" == "true" || "$flag" == "yes" ]]; then
    return 0
  fi
  # Auto: other vhosts already present → never steal default_server
  [[ "$(count_other_nginx_sites)" -gt 0 ]]
}

http_block_default() {
  local port="$1"
  # Exclusive install: catch-all on :80 (safe only when no other sites)
  cat <<EOF
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    root /opt/astra/frontend/dist;
    index index.html;
    client_max_body_size 50m;
$(panel_locations "$port")
}
EOF
}

# Shared hosting: do NOT touch :80 catch-all — IP access is via bind host :app_port
http_block_share_note() {
  local port="$1" bind
  bind="$(get_env ASTRA_BIND_HOST 0.0.0.0)"
  cat <<EOF
# Shared mode: other nginx sites left untouched.
# Panel IP access: http://SERVER_IP:${port}/  (uvicorn bind ${bind})
# Add a panel domain via x-astra to proxy on :80/:443 for that hostname only.
EOF
}

http_block_domain() {
  local domain="$1" port="$2" mode="${3:-panel}"
  local root_line="    root /opt/astra/frontend/dist;"
  local index_line="    index index.html;"
  if [[ "$mode" == "sub" ]]; then
    root_line=""
    index_line=""
  fi
  cat <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};
${root_line}
${index_line}
    client_max_body_size 50m;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

$(locations_for_mode "$port" "$mode")
}
EOF
}

ssl_block_domain() {
  local domain="$1" port="$2" mode="${3:-panel}"
  local ssl_opts="" dh=""
  local root_line="    root /opt/astra/frontend/dist;"
  local index_line="    index index.html;"
  if [[ "$mode" == "sub" ]]; then
    root_line=""
    index_line=""
  fi
  if [[ -f /etc/letsencrypt/options-ssl-nginx.conf ]]; then
    ssl_opts="    include /etc/letsencrypt/options-ssl-nginx.conf;"
  fi
  if [[ -f /etc/letsencrypt/ssl-dhparams.pem ]]; then
    dh="    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;"
  fi
  cat <<EOF
server {
    listen 80;
    listen [::]:80;
    server_name ${domain};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://\$host\$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name ${domain};

    ssl_certificate     /etc/letsencrypt/live/${domain}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${domain}/privkey.pem;
${ssl_opts}
${dh}

${root_line}
${index_line}
    client_max_body_size 50m;
$(locations_for_mode "$port" "$mode")
}
EOF
}

render_nginx() {
  local port panel_dom sub_dom ssl_panel ssl_sub share=0
  port="$(read_port)"
  panel_dom="$(get_env ASTRA_PANEL_DOMAIN "")"
  sub_dom="$(get_env ASTRA_SUB_DOMAIN "")"
  ssl_panel="$(get_env ASTRA_SSL_PANEL 0)"
  ssl_sub="$(get_env ASTRA_SSL_SUB 0)"
  if is_share_mode; then
    share=1
  fi

  echo "# Managed by astra-helper — do not edit by hand"
  echo "# Generated $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "# mode=$([ "$share" -eq 1 ] && echo shared || echo exclusive)"
  echo

  if [[ "$share" -eq 1 ]]; then
    http_block_share_note "$port"
    echo
  else
    http_block_default "$port"
    echo
  fi

  if [[ -n "$panel_dom" ]]; then
    if [[ "$ssl_panel" == "1" && -f "/etc/letsencrypt/live/${panel_dom}/fullchain.pem" ]]; then
      ssl_block_domain "$panel_dom" "$port" "panel"
    else
      http_block_domain "$panel_dom" "$port" "panel"
    fi
    echo
  fi

  if [[ -n "$sub_dom" && "$sub_dom" != "$panel_dom" ]]; then
    if [[ "$ssl_sub" == "1" && -f "/etc/letsencrypt/live/${sub_dom}/fullchain.pem" ]]; then
      ssl_block_domain "$sub_dom" "$port" "sub"
    else
      http_block_domain "$sub_dom" "$port" "sub"
    fi
    echo
  fi
}

cmd_reload_nginx() {
  need_root
  nginx -t
  systemctl reload nginx
  echo "nginx reloaded"
}

cmd_write_nginx() {
  need_root
  local src="${1:-}"
  local tmp
  tmp="$(mktemp)"
  if [[ -n "$src" && -f "$src" ]]; then
    cp "$src" "$tmp"
  else
    render_nginx > "$tmp"
  fi
  nginx -t -c /etc/nginx/nginx.conf 2>/dev/null || true
  install -m 644 "$tmp" "$NGINX_SITE"
  rm -f "$tmp"
  ln -sfn "$NGINX_SITE" "$NGINX_LINK"

  # Only disable stock nginx "default" welcome site when Astra owns :80 (exclusive).
  # Never remove other vhosts.
  if ! is_share_mode; then
    if [[ -L /etc/nginx/sites-enabled/default ]]; then
      rm -f /etc/nginx/sites-enabled/default
    fi
  fi

  nginx -t
  systemctl reload nginx || systemctl restart nginx
  echo "nginx config written → $NGINX_SITE (share=$(is_share_mode && echo yes || echo no))"
}

cmd_uninstall() {
  need_root
  local purge_data="${1:-}"
  echo "astra-helper: uninstalling Astra (other sites / DBs untouched)…"

  systemctl stop astra 2>/dev/null || true
  systemctl disable astra 2>/dev/null || true
  systemctl stop astra-update.service 2>/dev/null || true
  systemctl disable astra-update.service 2>/dev/null || true

  rm -f /etc/systemd/system/astra.service
  rm -f /etc/systemd/system/astra-update.service
  systemctl daemon-reload
  systemctl reset-failed astra 2>/dev/null || true

  # Remove ONLY Astra nginx site
  rm -f "$NGINX_LINK"
  rm -f "$NGINX_SITE"
  if command -v nginx >/dev/null 2>&1; then
    nginx -t 2>/dev/null && systemctl reload nginx 2>/dev/null || true
  fi

  rm -f /usr/local/bin/astra-helper
  rm -f /usr/local/bin/x-astra
  rm -f /etc/sudoers.d/astra

  # Optional: remove Let's Encrypt certs that belong only to Astra domains
  local panel_dom sub_dom
  panel_dom="$(get_env ASTRA_PANEL_DOMAIN "")"
  sub_dom="$(get_env ASTRA_SUB_DOMAIN "")"
  if command -v certbot >/dev/null 2>&1; then
    for d in "$panel_dom" "$sub_dom"; do
      [[ -n "$d" ]] || continue
      if [[ -d "/etc/letsencrypt/live/${d}" ]]; then
        certbot delete --cert-name "$d" --non-interactive 2>/dev/null || true
      fi
    done
  fi

  if [[ "$purge_data" == "--purge" ]]; then
    rm -rf "$ASTRA_ROOT"
    if id astra >/dev/null 2>&1; then
      userdel astra 2>/dev/null || true
    fi
    echo "astra-helper: purged /opt/astra and user astra"
  else
    # Keep tree but stop serving; leave data for recovery unless purged
    echo "astra-helper: services/bins removed; data kept at $ASTRA_ROOT (use --purge to delete)"
  fi
  echo "astra-helper: uninstall complete"
}

cmd_issue_ssl() {
  need_root
  local domain="${1:-}"
  [[ -n "$domain" ]] || die "usage: issue-ssl <domain>"
  valid_domain "$domain" || die "invalid domain: $domain"

  mkdir -p /var/www/html
  local email="admin@${domain}"

  if ! command -v certbot >/dev/null 2>&1; then
    die "certbot not installed"
  fi

  # Ensure HTTP server_name exists before certbot --nginx
  cmd_write_nginx

  certbot --nginx -d "$domain" \
    --non-interactive --agree-tos \
    --email "$email" \
    --redirect \
    --keep-until-expiring \
    || certbot certonly --nginx -d "$domain" \
      --non-interactive --agree-tos \
      --email "$email"

  # Mark SSL flags
  local panel_dom sub_dom
  panel_dom="$(get_env ASTRA_PANEL_DOMAIN "")"
  sub_dom="$(get_env ASTRA_SUB_DOMAIN "")"
  if [[ "$domain" == "$panel_dom" ]]; then
    set_env_key ASTRA_SSL_PANEL 1
    set_env_key PANEL_BASE_URL "https://${domain}"
  fi
  if [[ "$domain" == "$sub_dom" || ( -z "$sub_dom" && "$domain" == "$panel_dom" ) ]]; then
    if [[ "$domain" == "$sub_dom" ]] || [[ -z "$sub_dom" ]]; then
      set_env_key ASTRA_SSL_SUB 1
      set_env_key SUB_BASE_URL "https://${domain}"
    fi
  fi
  if [[ -z "$sub_dom" && "$domain" == "$panel_dom" ]]; then
    set_env_key SUB_BASE_URL "https://${domain}"
  fi

  cmd_write_nginx
  echo "SSL issued for $domain"
}

cmd_set_env() {
  need_root
  local key="${1:-}" val="${2:-}"
  [[ -n "$key" ]] || die "usage: set-env KEY VALUE"
  if [[ "$key" == "ASTRA_APP_PORT" ]]; then
    valid_port "$val" || die "invalid port"
  fi
  if [[ "$key" == "ASTRA_PANEL_DOMAIN" || "$key" == "ASTRA_SUB_DOMAIN" ]]; then
    if [[ -n "$val" ]]; then
      valid_domain "$val" || die "invalid domain: $val"
    fi
  fi
  set_env_key "$key" "$val"
  echo "set ${key}"
}

cmd_restart_astra() {
  need_root
  systemctl daemon-reload
  systemctl restart astra
  echo "astra restarted"
}

read_local_version() {
  if [[ -f "${ASTRA_ROOT}/VERSION" ]]; then
    head -n1 "${ASTRA_ROOT}/VERSION" | tr -d '\r' | tr -d ' '
  else
    echo "0.0.0"
  fi
}

fetch_remote_version() {
  local v=""
  local url
  for url in \
    "https://raw.githubusercontent.com/mohammadgholamisama/astra/main/VERSION" \
    "https://cdn.jsdelivr.net/gh/mohammadgholamisama/astra@main/VERSION"
  do
    v="$(curl -fsSL --max-time 15 "$url" 2>/dev/null | head -n1 | tr -d '\r' | tr -d ' ' || true)"
    if [[ -n "$v" && "$v" =~ ^[0-9A-Za-z._+-]+$ ]]; then
      echo "$v"
      return 0
    fi
  done
  echo ""
  return 1
}

cmd_check_update() {
  # Prints one JSON line. check_ok=false means we could NOT verify — never imply "up to date".
  local local_ver remote_ver git_behind=false update=false check_ok=false msg
  local_ver="$(read_local_version)"
  remote_ver="$(fetch_remote_version || true)"

  if [[ -z "$remote_ver" ]]; then
    printf '%s\n' "{\"check_ok\":false,\"local_version\":\"${local_ver}\",\"remote_version\":\"\",\"update_available\":false,\"git_behind\":false,\"message\":\"دریافت نسخه از گیت‌هاب ناموفق — دوباره تلاش کنید\"}"
    return 0
  fi
  check_ok=true

  # Semver-ish compare via sort -V
  if [[ "$(printf '%s\n%s\n' "$local_ver" "$remote_ver" | sort -V | tail -n1)" == "$remote_ver" \
        && "$local_ver" != "$remote_ver" ]]; then
    update=true
  fi

  if [[ -d "${ASTRA_ROOT}/.git" ]]; then
    # fetch may fail for user astra; try anyway (works as root)
    if git -C "$ASTRA_ROOT" fetch origin main --quiet 2>/dev/null; then
      local local_sha remote_sha
      local_sha="$(git -C "$ASTRA_ROOT" rev-parse HEAD 2>/dev/null || true)"
      remote_sha="$(git -C "$ASTRA_ROOT" rev-parse origin/main 2>/dev/null || true)"
      if [[ -n "$local_sha" && -n "$remote_sha" && "$local_sha" != "$remote_sha" ]]; then
        git_behind=true
        update=true
      fi
    fi
  fi

  if [[ "$update" == "true" ]]; then
    msg="نسخه جدید موجود است"
  else
    msg="پنل به‌روز است"
  fi

  printf '%s\n' "{\"check_ok\":true,\"local_version\":\"${local_ver}\",\"remote_version\":\"${remote_ver}\",\"update_available\":${update},\"git_behind\":${git_behind},\"message\":\"${msg}\"}"
}

cmd_apply_update() {
  need_root
  [[ -d "$ASTRA_ROOT" ]] || die "Astra not installed at $ASTRA_ROOT"

  # Never touch data / .env
  local data_ok=0
  [[ -f "$ENV_FILE" ]] || die ".env missing — abort"
  [[ -d "${ASTRA_ROOT}/data" ]] && data_ok=1

  echo "astra-helper: fetching latest code (preserving .env + data)…"
  if [[ -d "${ASTRA_ROOT}/.git" ]]; then
    git -C "$ASTRA_ROOT" fetch origin main
    git -C "$ASTRA_ROOT" reset --hard origin/main
  else
    # Fallback: sparse sync via tarball without wiping data/.env
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL "https://codeload.github.com/mohammadgholamisama/astra/tar.gz/refs/heads/main" \
      | tar -xz -C "$tmp" --strip-components=1
    rsync -a \
      --exclude '.env' \
      --exclude 'data/' \
      --exclude 'backend/.venv/' \
      --exclude 'frontend/node_modules/' \
      --exclude 'frontend/dist/' \
      "$tmp"/ "$ASTRA_ROOT"/
    rm -rf "$tmp"
  fi

  [[ -f "$ENV_FILE" ]] || die ".env disappeared — abort"
  [[ "$data_ok" -eq 1 && ! -d "${ASTRA_ROOT}/data" ]] && die "data/ missing after update — abort"

  install -m 755 "${ASTRA_ROOT}/deploy/astra-helper" /usr/local/bin/astra-helper
  install -m 755 "${ASTRA_ROOT}/deploy/x-astra" /usr/local/bin/x-astra
  if [[ -f "${ASTRA_ROOT}/deploy/sudoers.astra" ]]; then
    install -m 440 "${ASTRA_ROOT}/deploy/sudoers.astra" /etc/sudoers.d/astra
    if command -v visudo >/dev/null 2>&1; then
      visudo -cf /etc/sudoers.d/astra >/dev/null || die "invalid sudoers"
    fi
  fi
  if [[ -f "${ASTRA_ROOT}/deploy/astra.service" ]]; then
    install -m 644 "${ASTRA_ROOT}/deploy/astra.service" /etc/systemd/system/astra.service
  fi
  if [[ -f "${ASTRA_ROOT}/deploy/astra-update.service" ]]; then
    install -m 644 "${ASTRA_ROOT}/deploy/astra-update.service" /etc/systemd/system/astra-update.service
  fi
  systemctl daemon-reload

  echo "astra-helper: python deps…"
  sudo -u astra bash -c "
    set -e
    cd '${ASTRA_ROOT}/backend'
    . .venv/bin/activate
    pip install -r requirements.txt
  "

  echo "astra-helper: frontend build…"
  bash -c "
    set -e
    cd '${ASTRA_ROOT}/frontend'
    export VITE_API_BASE=
    if [[ -f package-lock.json ]]; then npm ci || npm install; else npm install; fi
    npm run build
    chown -R astra:astra '${ASTRA_ROOT}/frontend/dist' 2>/dev/null || true
    chmod -R a+rX '${ASTRA_ROOT}/frontend/dist'
  "

  cmd_write_nginx
  cmd_restart_astra

  local ver
  ver="$(read_local_version)"
  printf '%s\n' "{\"ok\":true,\"local_version\":\"${ver}\",\"remote_version\":\"${ver}\",\"message\":\"updated\"}"
}

cmd_set_admin() {
  need_root
  local new_user="${1:-}" new_pass="${2:-}"
  [[ -n "$new_user" && -n "$new_pass" ]] || die "usage: set-admin <username> <password>"
  [[ "$new_user" =~ ^[A-Za-z0-9_.@-]{3,64}$ ]] || die "invalid username (3-64: letters, digits, _ . @ -)"
  [[ "${#new_pass}" -ge 8 ]] || die "password must be at least 8 characters"
  [[ "$new_pass" != *$'\n'* && "$new_pass" != *$'\r'* ]] || die "invalid password"
  [[ -f "$ENV_FILE" ]] || die ".env missing"

  set_env_key ADMIN_USERNAME "$new_user"
  set_env_key ADMIN_PASSWORD "$new_pass"

  # Update / create admin row in isolated SQLite (do not touch other DBs)
  export ADMIN_USERNAME="$new_user"
  export ADMIN_PASSWORD="$new_pass"
  # shellcheck disable=SC1091
  set -a
  # Load rest of .env for DATABASE_URL / SECRET_KEY without overriding the two we set
  # shellcheck disable=SC1090
  source <(grep -vE '^(ADMIN_USERNAME|ADMIN_PASSWORD)=' "$ENV_FILE" | sed 's/\r$//' || true)
  set +a
  export ADMIN_USERNAME="$new_user"
  export ADMIN_PASSWORD="$new_pass"

  sudo -u astra -E bash -c "
    set -e
    cd '${ASTRA_ROOT}/backend'
    . .venv/bin/activate
    python - <<'PY'
import asyncio
import os
from sqlalchemy import select
from app.core.database import AsyncSessionLocal
from app.core.security import hash_password
from app.models.admin import Admin

new_user = os.environ['ADMIN_USERNAME'].strip()
new_pass = os.environ['ADMIN_PASSWORD']

async def main():
    async with AsyncSessionLocal() as db:
        rows = (await db.execute(select(Admin).order_by(Admin.id))).scalars().all()
        target = None
        for a in rows:
            if a.is_sudo:
                target = a
                break
        if target is None and rows:
            target = rows[0]
        for a in rows:
            if a is not target and a.username == new_user:
