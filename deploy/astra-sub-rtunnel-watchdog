#!/bin/bash
# Require 3 consecutive reverse-path failures before restart (avoid thrash/502).
set -uo pipefail
EDGE_IP=5.202.8.221
UNIT=astra-sub-rtunnel.service
LOGTAG=astra-sub-rtunnel-watchdog
KEY=/root/.ssh/astra_sub_rtunnel
FAIL_FILE=/run/astra-sub-rtunnel-failcount

if ! curl -fsS -o /dev/null --connect-timeout 2 --max-time 3 http://127.0.0.1:2086/health; then
  logger -t "$LOGTAG" "local astra health down — skip"
  exit 0
fi

if ! systemctl is-active --quiet "$UNIT"; then
  logger -t "$LOGTAG" "unit inactive — start"
  systemctl start "$UNIT" || true
  echo 0 >"$FAIL_FILE"
  exit 0
fi

ok=0
if timeout 18 ssh -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=yes -i "$KEY" "root@$EDGE_IP" \
    "curl -fsS -o /dev/null --connect-timeout 2 --max-time 5 http://127.0.0.1:18081/health" 2>/dev/null; then
  ok=1
fi

fails=0
[[ -f "$FAIL_FILE" ]] && fails=$(cat "$FAIL_FILE" 2>/dev/null || echo 0)
fails=${fails:-0}

if [[ "$ok" -eq 1 ]]; then
  echo 0 >"$FAIL_FILE"
  exit 0
fi

fails=$((fails + 1))
echo "$fails" >"$FAIL_FILE"
logger -t "$LOGTAG" "reverse probe fail count=$fails"
[[ "$fails" -lt 3 ]] && exit 0

timeout 18 ssh -o ConnectTimeout=8 -o BatchMode=yes -o StrictHostKeyChecking=yes -i "$KEY" "root@$EDGE_IP" \
  "fuser -k 18081/tcp >/dev/null 2>&1 || true" >/dev/null 2>&1 || true
logger -t "$LOGTAG" "restarting tunnel after $fails fails"
systemctl restart "$UNIT" || true
echo 0 >"$FAIL_FILE"
