[Unit]
Description=Astra sub reverse tunnel to Iranian edge (R 18081 -> local 2086)
After=network-online.target astra.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/astra-sub-rtunnel-run
Restart=always
RestartSec=3
TimeoutStartSec=40

[Install]
WantedBy=multi-user.target
