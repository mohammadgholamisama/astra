PORT=18080
BIND_HOST=127.0.0.1
API_KEY=change-me-to-a-long-random-secret
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0
# Keep & compare app test samples for this long (default 1h).
PING_TTL_SECONDS=3600
RATE_LIMIT_MAX=240
RATE_LIMIT_WINDOW_SECONDS=60

# Astra panel sync — on each /pings upload (debounced) + backup ticker:
#   POST {PANEL_BASE_URL}/api/admin/config-order/ping-rank
# Order = packet loss → speed → ping across the 1h window (never auto-hide).
# PANEL_API_KEY must be an active Astra admin X-Api-Key.
PANEL_SYNC_ENABLED=true
PANEL_BASE_URL=https://p.vokqem.ir
PANEL_API_PATH=/api/admin/config-order
PANEL_API_KEY=
PANEL_TIMEOUT_SECONDS=20
