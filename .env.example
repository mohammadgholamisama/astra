# Local (no Postgres needed):
DATABASE_URL=sqlite+aiosqlite:///./astra.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://astra:astra_secret@localhost:5432/astra
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440
SUB_BASE_URL=http://localhost:8000
PANEL_BASE_URL=http://localhost:5173
PANEL_NAME=Astra
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Set by official install.sh (enables SSL from panel UI):
# ASTRA_HELPER=/usr/local/bin/astra-helper
# ASTRA_APP_PORT=2086
# ASTRA_PANEL_DOMAIN=
# ASTRA_SUB_DOMAIN=
# FRONTEND_DIST=/opt/astra/frontend/dist
